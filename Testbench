`timescale 1ns/1ps

module traffic_light_controller_tb;

    reg clk;
    reg reset;

    wire [1:0] rA;
    wire [1:0] rB;

    traffic_light_controller uut (
        .clk(clk),
        .reset(reset),
        .rA(rA),
        .rB(rB)
    );

    initial
    begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    initial
    begin
        reset = 1;
        #20;
        reset = 0;

        #300;

        $finish;
    end

    initial
    begin
        $display("Time\tReset\trA\trB");
        $monitor("%0t\t%b\t%b\t%b", $time, reset, rA, rB);
    end

endmodule
